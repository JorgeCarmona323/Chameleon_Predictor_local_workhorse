# Data files (large, not tracked)
*.csv
*.sdf
*.sdf.gz
*.pkl
*.h5

# But DO track these small ones
!data/.gitkeep
!data/reference_set.csv
!data/config.json
!results/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so

# Conda/pip
.conda/
.venv/
env/
venv/

# OS
.DS_Store
Thumbs.db
*.Zone.Identifier
*:Zone.Identifier

# Editor
.vscode/
.idea/
*.swp
*.swo

# Results (generated — optional to track)
results/
figures/

# Large conformer files
conformer_descriptors_raw.csv

# Dependencies (large binary files — store locally or on shared drive)
dependencies/

# Literature PDFs and lab docs (not code — store locally)
literature/
*.pdf

# Windows Office lock files
~$*

# Generated presentation decks (binary; rebuilt from scripts)
*.pptx

# Generated report documents (rebuilt from .md via export_docx.py)
docs/reports/*.docx

# Figures / plots / scanned images (not source)
*.png
*.jpg
*.jpeg
*.svg
*.gif

# Computation outputs / reference structures under data/ (regenerable or large)
data/**/*.xyz
data/**/*.out
data/**/*.cif
data/**/*.dwar
data/**/ensemble.json
